# resender configuration.
# Copy to .env and adjust. All variables are optional; defaults are shown.
# Note: SMTP credentials are NOT set here — configure them in the admin UI
# (they are stored in the SQLite database, not the environment).

# Port the server listens on.
PORT=3000

# Directory for the SQLite database (resender.db) and the generated session
# secret. In Docker this defaults to /data (a mounted volume).
DATA_DIR=./data

# Admin login password. If left as "admin", the UI shows a red "change this"
# banner after login. Change this before exposing resender publicly.
ADMIN_PASSWORD=admin

# Secret used to sign the admin session cookie. If unset, a random secret is
# generated once and persisted to $DATA_DIR/secret (recommended — leave blank).
# SESSION_SECRET=

# Public base URL of this instance. Used to render endpoint URLs and the
# ready-to-copy integration snippets shown in the admin UI.
BASE_URL=http://localhost:3000

# Set to true when running behind a reverse proxy (nginx/Caddy) so that client
# IP addresses (used for rate limiting and submission logs) are taken from the
# X-Forwarded-For header instead of the proxy's own address.
TRUST_PROXY=false

# Optional but strongly recommended. Create a Cloudflare Turnstile widget for
# the hostnames where your contact forms are embedded. Both values are required
# together; the secret is used only by the server.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional server-only transactional email. Raw rtk_ key belongs only in the caller.
TRANSACTIONAL_API_KEY_SHA256=
TRANSACTIONAL_DAILY_LIMIT=100
